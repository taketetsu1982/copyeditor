FROM node:26.8.2-bookworm-slim AS node
WORKDIR /dependencies
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM python:3.12.14-slim
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /dependencies/node_modules /opt/node_modules
COPY requirements.generated.txt /dependencies/requirements.generated.txt
RUN pip install --no-cache-dir -r /dependencies/requirements.generated.txt
COPY --from=node /usr/lib/*/libatomic.so.1 /usr/local/lib/
RUN ldconfig && node --version
WORKDIR /work
COPY package.json package-lock.json requirements.generated.txt ./
COPY Dockerfile tests/fixtures/Dockerfile.benchmark
COPY src src
COPY rules rules
COPY examples examples
COPY scripts scripts
COPY tests/integration/test_benchmark.py tests/integration/test_benchmark.py
ENV PYTHONPATH=/work/src PROMPTFOO_PYTHON=/usr/local/bin/python \
    PROMPTFOO_CONFIG_DIR=/tmp/promptfoo PROMPTFOO_DISABLE_TELEMETRY=1 \
    PROMPTFOO_DISABLE_UPDATE=1 COPYEDITOR_BENCHMARK_CONTAINER=1
USER 65532:65532
ENTRYPOINT ["python", "-m", "pytest", "-p", "no:cacheprovider", "-o", "markers=consumer(contract_id): real consumer", "tests/integration/test_benchmark.py", "-q"]
